{
  "name": "@peerwire/react",
  "version": "0.1.0",
  "description": "React hooks for Peerwire rooms: join a peer-to-peer room, list its members, chat, and share state across the room with no backend.",
  "license": "MIT OR Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/avinashid/peerwire.git", "directory": "packages/react" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "keywords": ["p2p", "webrtc", "react", "hooks", "multiplayer", "rooms"],
  "peerDependencies": {
    "@peerwire/js": ">=0.1.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@peerwire/js": "file:../js",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p example/tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "test": "node test/hooks.mjs"
  }
}
