{
  "name": "@peerwire/js",
  "version": "0.1.0",
  "description": "Peer-to-peer rooms for the browser and Node with no backend: the Peerwire core as a zero-import wasm, WebRTC DataChannels and Nostr signaling.",
  "license": "MIT OR Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/avinashid/peerwire.git", "directory": "packages/js" },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./peerwire_ffi.wasm": "./pkg/peerwire_ffi.wasm",
    "./package.json": "./package.json"
  },
  "files": ["src", "pkg/peerwire_ffi.wasm"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "keywords": ["p2p", "webrtc", "multiplayer", "nostr", "wasm", "rooms"],
  "scripts": {
    "build": "./build.sh",
    "prepack": "./build.sh",
    "bench": "node test/bench.mjs",
    "test": "node test/node_pair.mjs && node test/room_node.mjs && node test/readme.mjs && node test/poll.mjs"
  }
}
