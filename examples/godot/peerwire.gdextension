; Points at the workspace build: run `cargo build --release -p peerwire-godot` first.

[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
linux = "res://../../target/release/libpeerwire_godot.so"
windows = "res://../../target/release/peerwire_godot.dll"
macos = "res://../../target/release/libpeerwire_godot.dylib"
